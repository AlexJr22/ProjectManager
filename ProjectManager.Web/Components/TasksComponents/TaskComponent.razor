<div class="col">
    <div class="border p-3">
        <h2>@Name</h2>

        <div class="d-flex justify-content-between">
            <span>@DateOfCreation</span>
            <span>@Status</span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? DateOfCreation { get; set; }

    [Parameter]
    public string? Status { get; set; }
}
